  "chunks": [
    {
      "index": 0,
      "text": "Hoş geldiniz.",
      "file": "c000.ogg",
      "durationSec": 3.72
    },
    {
      "index": 1,
      "text": "Varış için zaman ayırın.",
      "file": "c001.ogg",
      "durationSec": 4.68
    },
    {
      "index": 2,
      "text": "Destekle oturun veya yatın.",
      "file": "c002.ogg",
      "durationSec": 5.376
    },
    {
      "index": 3,
      "text": "Güvenli hissediyorsanız gözlerinizi kapatın.",
      "file": "c003.ogg",
      "durationSec": 6.864
    },
    {
      "index": 4,
      "text": "Yerle teması hissedin.",
      "file": "c004.ogg",
      "durationSec": 4.704
    },
    {
      "index": 5,
      "text": "Yavaş nefes alın.",
      "file": "c005.ogg",
      "durationSec": 4.104
    },
    {
      "index": 6,
      "text": "Uzun nefes verin.",
      "file": "c006.ogg",
      "durationSec": 4.296
    },
    {
      "index": 7,
      "text": "[durdur:27]",
      "file": "c007.ogg",
      "durationSec": 4.68
    },
    {
      "index": 8,
      "text": "Tekrar.",
      "file": "c008.ogg",
      "durationSec": 2.904
    },
    {
      "index": 9,
      "text": "[durdur:27]",
      "file": "c009.ogg",
      "durationSec": 4.68
    },
    {
      "index": 10,
      "text": "Omuzlarınızı düşürün.",
      "file": "c010.ogg",
      "durationSec": 4.56
    },
    {
      "index": 11,
      "text": "Karnı gevşet.",
      "file": "c011.ogg",
      "durationSec": 3.792
    },
    {
      "index": 12,
      "text": "[durdur:34]",
      "file": "c012.ogg",
      "durationSec": 4.584
    },
    {
      "index": 13,
      "text": "İyilikleri genişleyen bir daire içinde sunacağız.",
      "file": "c013.ogg",
      "durationSec": 7.056
    },
    {
      "index": 14,
      "text": "Cümleler davetlerdir, emirler değildir.",
      "file": "c014.ogg",
      "durationSec": 6.984
    },
    {
      "index": 15,
      "text": "[durdur:34]",
      "file": "c015.ogg",
      "durationSec": 4.584
    },
    {
      "index": 16,
      "text": "Kendinize doğru.",
      "file": "c016.ogg",
      "durationSec": 3.672
    },
    {
      "index": 17,
      "text": "Ben güvende olayım.",
      "file": "c017.ogg",
      "durationSec": 4.392
    },
    {
      "index": 18,
      "text": "[durdur:27]",
      "file": "c018.ogg",
      "durationSec": 4.68
    },
    {
      "index": 19,
      "text": "Ben iyi olayım.",
      "file": "c019.ogg",
      "durationSec": 3.792
    },
    {
      "index": 20,
      "text": "[durdur:27]",
      "file": "c020.ogg",
      "durationSec": 4.68
    },
    {
      "index": 21,
      "text": "Ben rahatça yaşayayım.",
      "file": "c021.ogg",
      "durationSec": 4.776
    },
    {
      "index": 22,
      "text": "[durdur:41]",
      "file": "c022.ogg",
      "durationSec": 4.272
    },
    {
      "index": 23,
      "text": "Tekrar, yavaşça.",
      "file": "c023.ogg",
      "durationSec": 4.368
    },
    {
      "index": 24,
      "text": "Ben güvende olayım.",
      "file": "c024.ogg",
      "durationSec": 4.392
    },
    {
      "index": 25,
      "text": "Ben iyi olayım.",
      "file": "c025.ogg",
      "durationSec": 3.792
    },
    {
      "index": 26,
      "text": "Ben rahatça yaşayayım.",
      "file": "c026.ogg",
      "durationSec": 3.6
    },
    {
      "index": 27,
      "text": "[durdur:69]",
      "file": "c027.ogg",
      "durationSec": 3.24
    },
    {
      "index": 28,
      "text": "Bir arkadaşınızı veya sevmesi kolay birini aklınıza getirin.",
      "file": "c028.ogg",
      "durationSec": 8.448
    },
    {
      "index": 29,
      "text": "Siz güvende olsun.",
      "file": "c029.ogg",
      "durationSec": 4.272
    },
    {
      "index": 30,
      "text": "[durdur:27]",
      "file": "c030.ogg",
      "durationSec": 4.68
    },
    {
      "index": 31,
      "text": "Siz iyi olsun.",
      "file": "c031.ogg",
      "durationSec": 2.64
    },
    {
      "index": 32,
      "text": "[durdur:27]",
      "file": "c032.ogg",
      "durationSec": 4.68
    },
    {
      "index": 33,
      "text": "Siz rahatça yaşayın.",
      "file": "c033.ogg",
      "durationSec": 4.392
    },
    {
      "index": 34,
      "text": "[durdur:69]",
      "file": "c034.ogg",
      "durationSec": 5.088
    },
    {
      "index": 35,
      "text": "Aklınıza nötr bir kişi getirin. Sadece az bilen biri.",
      "file": "c035.ogg",
      "durationSec": 10.056
    },
    {
      "index": 36,
      "text": "Güvenli olmanı dilerim.",
      "file": "c036.ogg",
      "durationSec": 4.584
    },
    {
      "index": 37,
      "text": "İyi olmanı dilerim.",
      "file": "c037.ogg",
      "durationSec": 4.104
    },
    {
      "index": 38,
      "text": "Rahatça yaşamanı dilerim.",
      "file": "c038.ogg",
      "durationSec": 4.872
    },
    {
      "index": 39,
      "text": "[durdur:69]",
      "file": "c039.ogg",
      "durationSec": 5.088
    },
    {
      "index": 40,
      "text": "Mümkünse, biraz hafifçe zor birini dahil et.",
      "file": "c040.ogg",
      "durationSec": 7.44
    },
    {
      "index": 41,
      "text": "Eğer bugün daha akıllıca olursa, kendine geri dön.",
      "file": "c041.ogg",
      "durationSec": 7.584
    },
    {
      "index": 42,
      "text": "Acıdan kurtulmanı dilerim.",
      "file": "c042.ogg",
      "durationSec": 4.944
    },
    {
      "index": 43,
      "text": "[durdur:55]",
      "file": "c043.ogg",
      "durationSec": 4.44
    },
    {
      "index": 44,
      "text": "Yakındaki ve uzaktaki tüm varlıklara genişlet.",
      "file": "c044.ogg",
      "durationSec": 7.104
    },
    {
      "index": 45,
      "text": "Tüm varlıkların güvenli olmasını dilerim.",
      "file": "c045.ogg",
      "durationSec": 6.24
    },
    {
      "index": 46,
      "text": "[durdur:34]",
      "file": "c046.ogg",
      "durationSec": 4.584
    },
    {
      "index": 47,
      "text": "Tüm varlıkların iyi olmasını dilerim.",
      "file": "c047.ogg",
      "durationSec": 5.808
    },
    {
      "index": 48,
      "text": "[durdur:34]",
      "file": "c048.ogg",
      "durationSec": 4.584
    },
    {
      "index": 49,
      "text": "Tüm varlıkların rahatça yaşamasını dilerim.",
      "file": "c049.ogg",
      "durationSec": 6.432
    },
    {
      "index": 50,
      "text": "[durdur:82]",
      "file": "c050.ogg",
      "durationSec": 4.8
    },
    {
      "index": 51,
      "text": "Kendi bedenine ve nefesine geri dön.",
      "file": "c051.ogg",
      "durationSec": 5.592
    },
    {
      "index": 52,
      "text": "Cümlelerin ardında kalan ışığın içinde dinlen.",
      "file": "c052.ogg",
      "durationSec": 6.576
    },
    {
      "index": 53,
      "text": "[durdur:150]",
      "file": "c053.ogg",
      "durationSec": 4.488
    },
    {
      "index": 54,
      "text": "Zorlamak gerekmiyor. Yumuşaklık yeterli.",
      "file": "c054.ogg",
      "durationSec": 8.856
    },
    {
      "index": 55,
      "text": "[durdur:137]",
      "file": "c055.ogg",
      "durationSec": 4.968
    },
    {
      "index": 56,
      "text": "[durdur:41]",
      "file": "c056.ogg",
      "durationSec": 4.272
    },
    {
      "index": 57,
      "text": "Nefesinizi derinleştirmeye başlayın.",
      "file": "c057.ogg",
      "durationSec": 6.024
    },
    {
      "index": 58,
      "text": "Burada dinlenin.",
      "file": "c058.ogg",
      "durationSec": 3.84
    },
    {
      "index": 59,
      "text": "[durdur:26]",
      "file": "c059.ogg",
      "durationSec": 4.8
    },
    {
      "index": 60,
      "text": "Yine odayı hissedin.",
      "file": "c060.ogg",
      "durationSec": 4.296
    },
    {
      "index": 61,
      "text": "Parmakları sallayın.",
      "file": "c061.ogg",
      "durationSec": 4.392
    },
    {
      "index": 62,
      "text": "Hazır olduğunuzda, gözlerinizi açın.",
      "file": "c062.ogg",
      "durationSec": 6.36
    },
    {
      "index": 63,
      "text": "Yavaşça bir sonraki adıma geçin.",
      "file": "c063.ogg",
      "durationSec": 5.736
    }
  ]
