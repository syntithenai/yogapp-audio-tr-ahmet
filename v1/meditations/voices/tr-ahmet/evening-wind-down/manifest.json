      "durationSec": 4.488
    },
    {
      "index": 14,
      "text": "Kalanlar sabah olana kadar bekleyebilir.",
      "file": "c014.ogg",
      "durationSec": 6.24
    },
    {
      "index": 15,
      "text": "Yatağın ya da zeminin size tuttuğunu hissedin.",
      "file": "c015.ogg",
      "durationSec": 6.816
    },
    {
      "index": 16,
      "text": "Nefes daha sessiz. Vücut daha ağır.",
      "file": "c016.ogg",
      "durationSec": 8.4
    },
    {
      "index": 17,
      "text": "Uyku gelirse, bırakın.",
      "file": "c017.ogg",
      "durationSec": 4.872
    },
    {
      "index": 18,
      "text": "Gelmezse, yine de bu yumuşaklıkta dinlenin.",
