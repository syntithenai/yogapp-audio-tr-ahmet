    {
      "index": 0,
      "text": "Bu uygulama günün sonu için tasarlanmıştır.",
      "file": "c000.ogg",
      "durationSec": 6.792
    },
    {
      "index": 1,
      "text": "İşte ışıkları kapatmak mümkünse yapın.",
      "file": "c001.ogg",
      "durationSec": 6.288
    },
    {
      "index": 2,
      "text": "Destekle yatın ya da yaslanın.",
      "file": "c002.ogg",
      "durationSec": 5.4
    },
    {
      "index": 3,
      "text": "Gün bitti, hatta zihin hâlâ görev listeleri hazırlarsa bile.",
      "file": "c003.ogg",
      "durationSec": 8.808
    },
    {
      "index": 4,
      "text": "Şimdi bunları bırakabilirsiniz.",
      "file": "c004.ogg",
      "durationSec": 5.184
    },
    {
      "index": 5,
      "text": "Dört sayım için yumuşakça nefes alın.",
      "file": "c005.ogg",
      "durationSec": 6.168
    },
    {
      "index": 6,
      "text": "Altı sayım için nefes verin.",
      "file": "c006.ogg",
      "durationSec": 5.352
    },
    {
      "index": 7,
      "text": "Tekrar edin: Dört al, altı ver.",
      "file": "c007.ogg",
      "durationSec": 5.784
    },
    {
      "index": 8,
      "text": "Uzun nefesler bedene uygun bir dinlenme sağlar.",
      "file": "c008.ogg",
      "durationSec": 7.344
    },
    {
      "index": 9,
      "text": "Yüzde kalan gerilimi tarayın.",
      "file": "c009.ogg",
      "durationSec": 5.016
    },
    {
      "index": 10,
      "text": "Alnınızı yumuşatın. Diş çenesini yumuşatın.",
      "file": "c010.ogg",
      "durationSec": 9.096
    },
    {
      "index": 11,
      "text": "Omuzlarınızı kulaklardan uzaklaştırın.",
      "file": "c011.ogg",
      "durationSec": 6.264
    },
    {
      "index": 12,
      "text": "Günün rüzgârın ardından toz gibi düşmesini hayal edin.",
      "file": "c012.ogg",
      "durationSec": 7.848
    },
    {
      "index": 13,
      "text": "Ne olduysa, oldu.",
