  "chunks": [
    {
      "index": 0,
      "text": "Hoş geldiniz.",
      "file": "c000.ogg",
      "durationSec": 3.72
    },
    {
      "index": 1,
      "text": "Kaldırılmış pozisyonda kalmayı sürdürün. Bu, çalışma ortasında yapılıyor.",
      "file": "c001.ogg",
      "durationSec": 11.736
    },
    {
      "index": 2,
      "text": "Bir an için ekranı gözden uzaklaştırın.",
      "file": "c002.ogg",
      "durationSec": 6.432
    },
    {
      "index": 3,
      "text": "Eğer mümkünse daha uzağa bakın.",
      "file": "c003.ogg",
      "durationSec": 5.472
    },
    {
      "index": 4,
      "text": "[bekleme:28]",
      "file": "c004.ogg",
      "durationSec": 5.16
    },
    {
      "index": 5,
      "text": "Omuzları yukarı, geri ve aşağı doğru döndürün.",
      "file": "c005.ogg",
      "durationSec": 7.32
    },
    {
      "index": 6,
      "text": "İkinci kez daha yapın.",
      "file": "c006.ogg",
      "durationSec": 4.44
    },
    {
      "index": 7,
      "text": "[bekleme:38]",
      "file": "c007.ogg",
      "durationSec": 5.136
    },
    {
      "index": 8,
      "text": "Elleri açıp kapatın.",
      "file": "c008.ogg",
      "durationSec": 4.536
    },
    {
      "index": 9,
      "text": "Hafifçe sallayın.",
      "file": "c009.ogg",
      "durationSec": 4.104
    },
    {
      "index": 10,
      "text": "[bekleme:28]",
      "file": "c010.ogg",
      "durationSec": 5.16
    },
    {
      "index": 11,
      "text": "Alnın dokunuşunu yumuşatın.",
      "file": "c011.ogg",
      "durationSec": 5.136
    },
    {
      "index": 12,
      "text": "Dişlerinizi gevşetin, dilinizi dinlendirin.",
      "file": "c012.ogg",
      "durationSec": 7.056
    },
    {
      "index": 13,
      "text": "[bekleme:38]",
      "file": "c013.ogg",
      "durationSec": 5.136
    },
    {
      "index": 14,
      "text": "Göğüs kemiğinin yanlarına nefes alın.",
      "file": "c014.ogg",
      "durationSec": 5.832
    },
    {
      "index": 15,
      "text": "Nefes verin ve göğsünüzü dinlendirin.",
      "file": "c015.ogg",
      "durationSec": 6.264
    },
    {
      "index": 16,
      "text": "[bekleme:38]",
      "file": "c016.ogg",
      "durationSec": 5.136
    },
    {
      "index": 17,
      "text": "Yavaşça üç kez gözlerinizi kırpın.",
      "file": "c017.ogg",
      "durationSec": 6.024
    },
    {
      "index": 18,
      "text": "[bekleme:28]",
      "file": "c018.ogg",
      "durationSec": 5.16
    },
    {
      "index": 19,
      "text": "Bir daha tam nefes alın.",
      "file": "c019.ogg",
      "durationSec": 5.064
    },
    {
      "index": 20,
      "text": "Hazırsanız, biraz daha az gerilerek dönmeye devam edin.",
      "file": "c020.ogg",
      "durationSec": 8.304
    },
    {
      "index": 21,
      "text": "[bekleme:28]",
      "file": "c021.ogg",
      "durationSec": 5.16
    },
    {
      "index": 22,
      "text": "Bir daha kolay nefes alın.",
      "file": "c022.ogg",
      "durationSec": 5.28
    },
    {
      "index": 23,
      "text": "Parmaklarınızı sallayın.",
      "file": "c023.ogg",
      "durationSec": 4.728
    },
    {
      "index": 24,
      "text": "Hazır olduğunuzda, gözlerinizi açın.",
      "file": "c024.ogg",
      "durationSec": 6.36
    },
    {
      "index": 25,
      "text": "Rahatlığı bir sonraki görevinize taşıyın.",
      "file": "c025.ogg",
      "durationSec": 6.48
    }
  ]
}
