  "chunks": [
    {
      "index": 0,
      "text": "Hoş geldiniz.",
      "file": "c000.ogg",
      "durationSec": 3.72
    },
    {
      "index": 1,
      "text": "Rahat bir oturma pozisyonu alın, eğer daha iyi hissediyorsanız uzanın.",
      "file": "c001.ogg",
      "durationSec": 9.408
    },
    {
      "index": 2,
      "text": "Ellerinizi rahat bırakın.",
      "file": "c002.ogg",
      "durationSec": 4.944
    },
    {
      "index": 3,
      "text": "Gözlerinizi yumuşatın ya da kapayın.",
      "file": "c003.ogg",
      "durationSec": 6.096
    },
    {
      "index": 4,
      "text": "Yavaş bir nefes alın.",
      "file": "c004.ogg",
      "durationSec": 4.488
    },
    {
      "index": 5,
      "text": "Ve daha uzun bir nefes verin.",
      "file": "c005.ogg",
      "durationSec": 5.136
    },
    {
      "index": 6,
      "text": "Eğer isterseniz bir elinizi alt karnınıza koyun.",
      "file": "c006.ogg",
      "durationSec": 7.104
    },
    {
      "index": 7,
      "text": "Karnın gergin olup olmadığını fark edin.",
      "file": "c007.ogg",
      "durationSec": 6.36
    },
    {
      "index": 8,
      "text": "[durdur:20]",
      "file": "c008.ogg",
      "durationSec": 4.344
    },
    {
      "index": 9,
      "text": "Sonraki nefes alma sırasında, karnın genişlemesine izin verin.",
      "file": "c009.ogg",
      "durationSec": 8.76
    },
    {
      "index": 10,
      "text": "Nefes verirken, sıkmadan düşmesine izin verin.",
      "file": "c010.ogg",
      "durationSec": 7.56
    },
    {
      "index": 11,
      "text": "[durdur:20]",
      "file": "c011.ogg",
      "durationSec": 4.344
    },
    {
      "index": 12,
      "text": "Tekrar. Yumuşak karn içeri.",
      "file": "c012.ogg",
      "durationSec": 7.2
    },
    {
      "index": 13,
      "text": "Yumuşak karn dışarı.",
      "file": "c013.ogg",
      "durationSec": 4.512
    },
    {
      "index": 14,
      "text": "[durdur:25]",
      "file": "c014.ogg",
      "durationSec": 4.584
    },
    {
      "index": 15,
      "text": "Eğer zihin tartışır, bedeni liderlik etmesine izin verin.",
      "file": "c015.ogg",
      "durationSec": 8.328
    },
    {
      "index": 16,
      "text": "Genişleme. Bırakma.",
      "file": "c016.ogg",
      "durationSec": 6.552
    },
    {
      "index": 17,
      "text": "[durdur:29]",
      "file": "c017.ogg",
      "durationSec": 4.848
    },
    {
      "index": 18,
      "text": "Omuzlar düşer.",
      "file": "c018.ogg",
      "durationSec": 4.128
    },
    {
      "index": 19,
      "text": "Çene gevşer.",
      "file": "c019.ogg",
      "durationSec": 3.48
    },
    {
      "index": 20,
      "text": "Karnın serbest.",
      "file": "c020.ogg",
      "durationSec": 3.936
    },
    {
      "index": 21,
      "text": "[durdur:25]",
      "file": "c021.ogg",
      "durationSec": 4.584
    },
    {
      "index": 22,
      "text": "On sakin yumuşak karn nefesiyle kalın.",
      "file": "c022.ogg",
      "durationSec": 6.48
    },
    {
      "index": 23,
      "text": "[durdur:45]",
      "file": "c023.ogg",
      "durationSec": 4.416
    },
    {
      "index": 24,
      "text": "Gelen herhangi bir rahatlığı fark edin.",
      "file": "c024.ogg",
      "durationSec": 6.192
    },
    {
      "index": 25,
      "text": "[durdur:20]",
      "file": "c025.ogg",
      "durationSec": 4.344
    },
    {
      "index": 26,
      "text": "Burada dinlenin.",
      "file": "c026.ogg",
      "durationSec": 3.84
    },
    {
      "index": 27,
      "text": "[durdur:27]",
      "file": "c027.ogg",
      "durationSec": 4.68
    },
    {
      "index": 28,
      "text": "Bir sonraki rahat nefes alın.",
      "file": "c028.ogg",
      "durationSec": 5.568
    },
    {
      "index": 29,
      "text": "Parmakları kıvırın.",
      "file": "c029.ogg",
      "durationSec": 4.152
    },
    {
      "index": 30,
      "text": "Hazır olduğunuzda, gözlerinizi açın.",
      "file": "c030.ogg",
      "durationSec": 6.36
    },
    {
      "index": 31,
      "text": "Bunu biraz sizde taşıyın.",
      "file": "c031.ogg",
      "durationSec": 5.016
    }
  ]
}
