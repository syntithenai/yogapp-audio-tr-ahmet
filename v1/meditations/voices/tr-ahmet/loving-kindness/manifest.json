  "chunks": [
    {
      "index": 0,
      "text": "Rahatça oturun. Yüzünüzü gevşetin.",
      "file": "c000.ogg",
      "durationSec": 7.992
    },
    {
      "index": 1,
      "text": "Yardımcı oluyorsa elinizi kalbinizin üzerine koyun.",
      "file": "c001.ogg",
      "durationSec": 7.56
    },
    {
      "index": 2,
      "text": "Basit naziklik ifadeleri sunacağız.",
      "file": "c002.ogg",
      "durationSec": 6.264
    },
    {
      "index": 3,
      "text": "Öncelikle kendinize.",
      "file": "c003.ogg",
      "durationSec": 4.584
    },
    {
      "index": 4,
      "text": "Sessizce benim arkamdan tekrarlayın ya da sadece dinleyin.",
      "file": "c004.ogg",
      "durationSec": 8.328
    },
    {
      "index": 5,
      "text": "Ben güvende olayım.",
      "file": "c005.ogg",
      "durationSec": 4.392
    },
    {
      "index": 6,
      "text": "Ben iyi olayım.",
      "file": "c006.ogg",
      "durationSec": 3.792
    },
    {
      "index": 7,
      "text": "Ben rahat olayım.",
      "file": "c007.ogg",
      "durationSec": 4.152
    },
    {
      "index": 8,
      "text": "Yavaşça tekrarlayın.",
      "file": "c008.ogg",
      "durationSec": 4.464
    },
    {
      "index": 9,
      "text": "Ben güvende olayım.",
      "file": "c009.ogg",
      "durationSec": 4.392
    },
    {
      "index": 10,
      "text": "Ben iyi olayım.",
      "file": "c010.ogg",
      "durationSec": 3.792
    },
    {
      "index": 11,
      "text": "Ben rahat olayım.",
      "file": "c011.ogg",
      "durationSec": 4.152
    },
    {
      "index": 12,
      "text": "Eğer bu zor geliyorsa, sorun değil. Dilek ile kalın.",
      "file": "c012.ogg",
      "durationSec": 9.84
    },
    {
      "index": 13,
      "text": "Şimdi, sevmesi kolay birini akıllara getirin.",
      "file": "c013.ogg",
      "durationSec": 6.792
    },
    {
      "index": 14,
      "text": "Bir arkadaş, bir evcil hayvan, nazik bir yabancı.",
      "file": "c014.ogg",
      "durationSec": 8.352
    },
    {
      "index": 15,
      "text": "Onları kısaca hayal edin.",
      "file": "c015.ogg",
      "durationSec": 5.088
    },
    {
      "index": 16,
      "text": "Siz güvende olun.",
      "file": "c016.ogg",
      "durationSec": 4.032
    },
    {
      "index": 17,
      "text": "Siz iyi olun.",
      "file": "c017.ogg",
      "durationSec": 3.456
    },
    {
      "index": 18,
      "text": "Siz rahat olun.",
      "file": "c018.ogg",
      "durationSec": 3.792
    },
    {
      "index": 19,
      "text": "Bir kez daha.",
      "file": "c019.ogg",
      "durationSec": 3.84
    },
    {
      "index": 20,
      "text": "Sizin için güvenli olun.",
      "file": "c020.ogg",
      "durationSec": 4.584
    },
    {
      "index": 21,
      "text": "Sizin için iyi olun.",
      "file": "c021.ogg",
      "durationSec": 4.128
    },
    {
      "index": 22,
      "text": "Sizin için rahat olun.",
      "file": "c022.ogg",
      "durationSec": 4.416
    },
    {
      "index": 23,
      "text": "Doğan ısınmayı hissedin. Ya da sadece bu sözlerde dinlenin.",
      "file": "c023.ogg",
      "durationSec": 10.68
    },
    {
      "index": 24,
      "text": "Kendi nefesinize döner misiniz.",
      "file": "c024.ogg",
      "durationSec": 5.376
    },
    {
      "index": 25,
      "text": "Pratik yapmak için kendinize teşekkür edin.",
      "file": "c025.ogg",
      "durationSec": 6.408
    },
    {
      "index": 26,
      "text": "Hafifçe gözlerinizi açın.",
