  "totalSec": 326,
  "chunks": [
    {
      "index": 0,
      "text": "Hoş geldiniz.",
      "file": "c000.ogg",
      "durationSec": 3.72
    },
    {
      "index": 1,
      "text": "Bu uygulama, sigara içmeyen biri olarak size aittir.",
      "file": "c001.ogg",
      "durationSec": 8.112
    },
    {
      "index": 2,
      "text": "Rahat bir oturma pozisyonu alın, daha iyi hissediyorsanız uzanın.",
      "file": "c002.ogg",
      "durationSec": 9.096
    },
    {
      "index": 3,
      "text": "Ellerinizi rahat bırakın.",
      "file": "c003.ogg",
      "durationSec": 4.944
    },
    {
      "index": 4,
      "text": "Gözlerinizi yumuşatın ya da kapayın.",
      "file": "c004.ogg",
      "durationSec": 6.096
    },
    {
      "index": 5,
      "text": "Yavaşça bir nefes alın.",
      "file": "c005.ogg",
      "durationSec": 4.752
    },
    {
      "index": 6,
      "text": "Ve daha uzun bir nefes verin.",
      "file": "c006.ogg",
      "durationSec": 4.32
    },
    {
      "index": 7,
      "text": "[durdur:16]",
      "file": "c007.ogg",
      "durationSec": 3.36
    },
    {
      "index": 8,
      "text": "Vücudunuzun desteklendiğini hissedin.",
      "file": "c008.ogg",
      "durationSec": 5.904
    },
    {
      "index": 9,
      "text": "Kanıtlayacak hiçbir şey yok. Acele edecek hiçbir yer yok.",
      "file": "c009.ogg",
      "durationSec": 2.04
    },
    {
      "index": 10,
      "text": "[durdur:16]",
      "file": "c010.ogg",
      "durationSec": 4.44
    },
    {
      "index": 11,
      "text": "Açık özgürlük ifadeleriyle çalışacağız.",
      "file": "c011.ogg",
      "durationSec": 0.12
    },
    {
      "index": 12,
      "text": "Dinleyin ya da doğru gelenleri sessizce tekrarlayın.",
      "file": "c012.ogg",
      "durationSec": 7.512
    },
    {
      "index": 13,
      "text": "[durdur:18]",
      "file": "c013.ogg",
      "durationSec": 4.584
    },
    {
      "index": 14,
      "text": "Şu anda sigara içmeyen biriyim.",
      "file": "c014.ogg",
      "durationSec": 5.376
    },
    {
      "index": 15,
      "text": "[durdur:16]",
      "file": "c015.ogg",
      "durationSec": 4.44
    },
    {
      "index": 16,
      "text": "Nikotin hastalığından kurtulduğum için çok mutluyum.",
      "file": "c016.ogg",
      "durationSec": 5.76
    },
    {
      "index": 17,
      "text": "[durdur:18]",
      "file": "c017.ogg",
      "durationSec": 4.584
    },
    {
      "index": 18,
      "text": "Sigara içmek artık hayatımın ya da kimliğimin bir parçası değil.",
      "file": "c018.ogg",
      "durationSec": 8.856
    },
    {
      "index": 19,
      "text": "[durdur:18]",
      "file": "c019.ogg",
      "durationSec": 4.584
    },
    {
      "index": 20,
      "text": "Bu tetikleyicileri geçmiş anılarım veya diğer sigara içenleri izlememden dolayı alıyorum.",
      "file": "c020.ogg",
      "durationSec": 11.112
    },
    {
      "index": 21,
      "text": "[durdur:18]",
      "file": "c021.ogg",
      "durationSec": 4.584
    },
    {
      "index": 22,
      "text": "Bu tetikleyiciler bana hiçbir şey yapamaz, çünkü bağımlılığın kölesinden kurtuldum.",
      "file": "c022.ogg",
      "durationSec": 10.656
    },
    {
      "index": 23,
      "text": "[durdur:22]",
      "file": "c023.ogg",
      "durationSec": 4.728
    },
    {
      "index": 24,
      "text": "Hâlâ sigara sahteliğine takılı kalmış sigara içenlere üzülüyorum.",
      "file": "c024.ogg",
      "durationSec": 8.76
    },
    {
      "index": 25,
      "text": "Nikotin tükenmesi, istek ve yeniden doldurma gibi acımasız döngüye mahkûm olanlara.",
      "file": "c025.ogg",
      "durationSec": 11.112
    },
    {
      "index": 26,
      "text": "[durdur:18]",
      "file": "c026.ogg",
      "durationSec": 4.584
    },
    {
      "index": 27,
      "text": "Artık onlar gibi acı çekmiyorum.",
      "file": "c027.ogg",
      "durationSec": 5.952
    },
    {
      "index": 28,
      "text": "[durdur:14]",
      "file": "c028.ogg",
      "durationSec": 4.344
    },
    {
      "index": 29,
      "text": "Şimdi gerçeği biliyorum.",
      "file": "c029.ogg",
      "durationSec": 4.536
    },
    {
      "index": 30,
      "text": "Sigarayla hiçbir fayda yok.",
      "file": "c030.ogg",
      "durationSec": 5.112
    },
    {
      "index": 31,
      "text": "[durdur:18]",
      "file": "c031.ogg",
      "durationSec": 4.584
    },
    {
      "index": 32,
      "text": "İdrar çubuğu hiçbir zaman kimseye yardımcı olmadı ve asla yardımcı olmayacak.",
      "file": "c032.ogg",
      "durationSec": 10.848
    },
    {
      "index": 33,
      "text": "[durdur:18]",
      "file": "c033.ogg",
      "durationSec": 4.584
    },
    {
      "index": 34,
      "text": "Sigara benim için birçok sorun yarattı.",
      "file": "c034.ogg",
      "durationSec": 6.168
    },
    {
      "index": 35,
      "text": "[durdur:14]",
      "file": "c035.ogg",
      "durationSec": 4.344
    },
    {
      "index": 36,
      "text": "Hayatımın en iyi kararını, o iğrenç zehri bir daha içmemek için verdim.",
      "file": "c036.ogg",
      "durationSec": 9.744
    },
    {
      "index": 37,
      "text": "Bu karar kesindir.",
      "file": "c037.ogg",
      "durationSec": 4.368
    },
    {
      "index": 38,
      "text": "[durdur:22]",
      "file": "c038.ogg",
      "durationSec": 4.728
    },
    {
      "index": 39,
      "text": "Şimdi, Sigara Yasasını saygı duyuyorum.",
      "file": "c039.ogg",
      "durationSec": 6.216
    },
    {
      "index": 40,
      "text": "[durdur:18]",
      "file": "c040.ogg",
      "durationSec": 4.584
    },
    {
      "index": 41,
      "text": "Şimdi, tüm durumlarım daha iyiye gidiyor.",
      "file": "c041.ogg",
      "durationSec": 6.12
    },
    {
      "index": 42,
      "text": "Daha mutlu, daha sağlıklı ve daha güvenli hale geliyorum.",
      "file": "c042.ogg",
      "durationSec": 8.208
    },
    {
      "index": 43,
      "text": "[durdur:22]",
      "file": "c043.ogg",
      "durationSec": 4.728
    },
    {
      "index": 44,
      "text": "Özgürüm.",
      "file": "c044.ogg",
      "durationSec": 3.192
    },
    {
      "index": 45,
      "text": "[durdur:28]",
      "file": "c045.ogg",
      "durationSec": 4.896
    },
    {
      "index": 46,
      "text": "Birkaç nefes boyunca bu özgürlükte kalın.",
      "file": "c046.ogg",
      "durationSec": 6.888
    },
    {
      "index": 47,
      "text": "Tetikleyiciler hâlâ eski bir hafızayla ziyaret edebilir.",
      "file": "c047.ogg",
      "durationSec": 8.28
    },
    {
      "index": 48,
      "text": "Sizi köleliğe geri döndüremezler.",
      "file": "c048.ogg",
      "durationSec": 5.4
    },
    {
      "index": 49,
      "text": "[durdur:36]",
      "file": "c049.ogg",
      "durationSec": 4.728
    },
    {
      "index": 50,
      "text": "Şu an bir sigara içmeyen biriyim.",
      "file": "c050.ogg",
      "durationSec": 5.616
    },
    {
      "index": 51,
      "text": "Özgürüm.",
      "file": "c051.ogg",
      "durationSec": 3.192
    },
    {
      "index": 52,
      "text": "[durdur:28]",
      "file": "c052.ogg",
      "durationSec": 4.896
    },
    {
      "index": 53,
      "text": "Bir nefes daha rahat alın.",
      "file": "c053.ogg",
      "durationSec": 5.112
    },
    {
      "index": 54,
      "text": "Parmakları sallayın.",
      "file": "c054.ogg",
      "durationSec": 4.392
    },
    {
      "index": 55,
      "text": "Hazır olduğunuzda, gözlerinizi açın.",
      "file": "c055.ogg",
      "durationSec": 6.36
    },
    {
      "index": 56,
      "text": "Bu özgürlüğü yanınızda taşıyın.",
      "file": "c056.ogg",
      "durationSec": 5.496
    }
  ]
}
