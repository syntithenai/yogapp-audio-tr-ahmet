{
  "id": "forest-clearing-5",
  "voiceId": "tr-ahmet",
  "edgeVoice": "tr-TR-AhmetNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 416,
  "chunks": [
    {
      "index": 0,
      "text": "Hoş geldiniz.",
      "file": "c000.ogg",
      "durationSec": 3.72
    },
    {
      "index": 1,
      "text": "Rahat bir oturun, ya da daha iyi hissediyorsanız uzanın.",
      "file": "c001.ogg",
      "durationSec": 8.112
    },
    {
      "index": 2,
      "text": "Ellerinizi rahatça bırakın.",
      "file": "c002.ogg",
      "durationSec": 5.184
    },
    {
      "index": 3,
      "text": "Gözlerinizi kapatın ya da bakışınızı yumuşatın.",
      "file": "c003.ogg",
      "durationSec": 7.224
    },
    {
      "index": 4,
      "text": "Vücudunuzun tutulduğu ağırlığı fark edin.",
      "file": "c004.ogg",
      "durationSec": 6.168
    },
    {
      "index": 5,
      "text": "Burnunuzdan yavaş bir nefes alın.",
      "file": "c005.ogg",
      "durationSec": 5.904
    },
    {
      "index": 6,
      "text": "Ve daha uzun, daha kolay bir nefes verin.",
      "file": "c006.ogg",
      "durationSec": 6.696
    },
    {
      "index": 7,
      "text": "Tekrar. Yumuşak bir nefes alın.",
      "file": "c007.ogg",
      "durationSec": 7.464
    },
    {
      "index": 8,
      "text": "Yavaşça nefes verin.",
      "file": "c008.ogg",
      "durationSec": 4.56
    },
    {
      "index": 9,
      "text": "Düşünceleriniz dağılacaksa, sorun değil. Nefese geri dönün.",
      "file": "c009.ogg",
      "durationSec": 11.064
    },
    {
      "index": 10,
      "text": "Şimdi, yumuşak yaprak döküntüsünün altında bir yolu hayal edin.",
      "file": "c010.ogg",
      "durationSec": 8.544
    },
    {
      "index": 11,
      "text": "Hızlı bir şekilde yürümeden, sessiz bir ormana giriyorsunuz.",
      "file": "c011.ogg",
      "durationSec": 8.376
    },
    {
      "index": 12,
      "text": "Leopar ışık, kollarınızın üzerinde hareket ediyor.",
      "file": "c012.ogg",
      "durationSec": 7.512
    },
    {
      "index": 13,
      "text": "Güneşin bulduğu her yerde hafif bir sıcaklık hissedin.",
      "file": "c013.ogg",
      "durationSec": 7.632
    },
    {
      "index": 14,
      "text": "Ağaçlar arasında esen bir hava, serin bir tazelik taşıyor.",
      "file": "c014.ogg",
      "durationSec": 8.448
    },
    {
      "index": 15,
      "text": "Yeşil toprak, kabuk ve temiz bir mineralli nem kokusunu alın.",
      "file": "c015.ogg",
      "durationSec": 8.736
    },
    {
      "index": 16,
      "text": "Yol, küçük bir açıklığa açılıyor.",
      "file": "c016.ogg",
      "durationSec": 5.52
    },
    {
      "index": 17,
      "text": "Moss, düşmüş bir kütüğü yumuşatır. Oturursun.",
      "file": "c017.ogg",
      "durationSec": 9.024
    },
    {
      "index": 18,
      "text": "Güneş ışığı, sessiz bir altın gibi merkezde birikir.",
      "file": "c018.ogg",
      "durationSec": 7.848
    },
    {
      "index": 19,
      "text": "Yüzünüze gelen o sıcaklığı yavaş ve nazik hissedin.",
      "file": "c019.ogg",
      "durationSec": 7.608
    },
    {
      "index": 20,
      "text": "Bir esinti saçlarını okşar ve terliklerinizi serinletir.",
      "file": "c020.ogg",
      "durationSec": 8.088
    },
    {
      "index": 21,
      "text": "Uzaktan kuş sesleri gelir, sonra yok olur.",
      "file": "c021.ogg",
      "durationSec": 7.104
    },
    {
      "index": 22,
      "text": "Nefesiniz yaprakların sessizliğiyle eşleşir.",
      "file": "c022.ogg",
      "durationSec": 6.984
    },
    {
      "index": 23,
      "text": "Tazeliği solun. Kalan aceleyi nefesle dışarı ver.",
      "file": "c023.ogg",
      "durationSec": 9.192
    },
    {
      "index": 24,
      "text": "Altınızda yere ne kadar güvenli hissettiğinizi fark edin.",
      "file": "c024.ogg",
      "durationSec": 7.992
    },
    {
      "index": 25,
      "text": "Kanopinin üzerindeki gökyüzünün ne kadar geniş göründüğünü.",
      "file": "c025.ogg",
      "durationSec": 7.656
    },
    {
      "index": 26,
      "text": "Bir böcek, güneşli bir kabuk parçasını geçer, acelesizce.",
      "file": "c026.ogg",
      "durationSec": 8.952
    },
    {
      "index": 27,
      "text": "Burada olmanız dışında hiçbir yere gitmeniz gerekmiyor.",
      "file": "c027.ogg",
      "durationSec": 7.824
    },
    {
      "index": 28,
      "text": "Yine sıcaklık kapalı göz kapaklarınızda birikir.",
      "file": "c028.ogg",
      "durationSec": 6.912
    },
    {
      "index": 29,
      "text": "Soğuk hava, nazik bir el gibi yakanızın altına süzülür.",
      "file": "c029.ogg",
      "durationSec": 7.968
    },
    {
      "index": 30,
      "text": "Yanaklarınızda sıcaklığı koruyun.",
      "file": "c030.ogg",
      "durationSec": 5.472
    },
    {
      "index": 31,
      "text": "Nefes verirken dudaklarınızda soğuk havayı koruyun.",
      "file": "c031.ogg",
      "durationSec": 7.584
    },
    {
      "index": 32,
      "text": "Bu alan hiçbir şey istemez. Sadece sizi tutar.",
      "file": "c032.ogg",
      "durationSec": 9.84
    },
    {
      "index": 33,
      "text": "Bir nefes daha tamamen karnınıza kadar gitsin.",
      "file": "c033.ogg",
      "durationSec": 7.392
    },
    {
      "index": 34,
      "text": "Ve yapraklar gibi yumuşak bir şekilde geri gitsin.",
      "file": "c034.ogg",
      "durationSec": 7.104
    },
    {
      "index": 35,
      "text": "Dikkatinizi yavaşça açıklığın kenarında gezdirin.",
      "file": "c035.ogg",
      "durationSec": 7.08
    },
    {
      "index": 36,
      "text": "Yosun. Gölgeler. Bir küpün tabanında soluk bir mantar.",
      "file": "c036.ogg",
      "durationSec": 12.312
    },
    {
      "index": 37,
      "text": "Her şey canlı çünkü acele etmiyorsunuz.",
      "file": "c037.ogg",
      "durationSec": 6.792
    },
    {
      "index": 38,
      "text": "Güneş ışığının dizinize düştiği yerde tekrar güneş ısısını hissedin.",
      "file": "c038.ogg",
      "durationSec": 9.12
    },
    {
      "index": 39,
      "text": "Boğazınızın üzerinden süzüldüğü yerde esinti soğukluğunu hissedin.",
      "file": "c039.ogg",
      "durationSec": 8.544
    },
    {
      "index": 40,
      "text": "Bütün öğleden sonra burada kalabilirsiniz. Şimdilik birkaç nefes yeterli.",
      "file": "c040.ogg",
      "durationSec": 11.928
    },
    {
      "index": 41,
      "text": "Şimdi bir süre nefesle birlikte dinlenin.",
      "file": "c041.ogg",
      "durationSec": 6.072
    },
    {
      "index": 42,
      "text": "Yavaşça nefes alın.",
      "file": "c042.ogg",
      "durationSec": 4.416
    },
    {
      "index": 43,
      "text": "Yavaşça nefes verin.",
      "file": "c043.ogg",
      "durationSec": 4.56
    },
    {
      "index": 44,
      "text": "Nefes alın.",
      "file": "c044.ogg",
      "durationSec": 3.456
    },
    {
      "index": 45,
      "text": "Nefes verin.",
      "file": "c045.ogg",
      "durationSec": 3.624
    },
    {
      "index": 46,
      "text": "Vücutta sıcak hissettiğiniz her yerde sıcaklığı hissedin.",
      "file": "c046.ogg",
      "durationSec": 8.016
    },
    {
      "index": 47,
      "text": "Havada serin hissettiğiniz her yerde soğukluğu hissedin.",
      "file": "c047.ogg",
      "durationSec": 7.704
    },
    {
      "index": 48,
      "text": "Nefes alın.",
      "file": "c048.ogg",
      "durationSec": 3.456
    },
    {
      "index": 49,
      "text": "Nefes verin.",
      "file": "c049.ogg",
      "durationSec": 3.624
    },
    {
      "index": 50,
      "text": "Gidecek yer yok. Düzeltilecek bir şey yok.",
      "file": "c050.ogg",
      "durationSec": 8.952
    },
    {
      "index": 51,
      "text": "Nefes alın.",
      "file": "c051.ogg",
      "durationSec": 3.456
    },
    {
      "index": 52,
      "text": "Nefes verin.",
      "file": "c052.ogg",
      "durationSec": 3.624
    },
    {
      "index": 53,
      "text": "Birkaç sessiz nefes için burada dinlenin.",
      "file": "c053.ogg",
      "durationSec": 6.552
    },
    {
      "index": 54,
      "text": "Bu yere her zaman geri dönebileceğinizi bilin.",
      "file": "c054.ogg",
      "durationSec": 6.744
    },
    {
      "index": 55,
      "text": "Hazır olduğunuzda nefesinizi derinleştirin.",
      "file": "c055.ogg",
      "durationSec": 6.336
    },
    {
      "index": 56,
      "text": "Parmaklarınızı ve ayak parmaklarınızı kıvırın.",
      "file": "c056.ogg",
      "durationSec": 6.792
    },
    {
      "index": 57,
      "text": "Gözlerinizi nazikçe açın.",
      "file": "c057.ogg",
      "durationSec": 5.4
    },
    {
      "index": 58,
      "text": "Bu huzurun bir kısmını yanınızda taşıyın.",
      "file": "c058.ogg",
      "durationSec": 6.48
    }
  ]
}
